    "def ram():\n",
    "    l=[1,2,[3,4],6,7]\n",
    "    k=[]\n",
    "    for i in l:\n",
    "        if isinstance(i, list):\n",
    "            k.extend(i)\n",
    "        else:\n",
    "            k.append(i)\n",
    "\n",
    "    return (str(k).replace(\" \", \"\"))\n",
    "print(ram())\n"
   ]
